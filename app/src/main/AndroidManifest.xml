<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_konnash"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KonnashApp">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".IncomeActivity" android:exported="true"></activity>
        <activity android:name=".CategoryActivity" android:exported="true"></activity>
        <activity android:name=".AddressActivity" android:exported="true"></activity>
        <activity android:name=".SuccessActivity" android:exported="true"></activity>
        <activity android:name=".CategoriesMgmtActivity" android:exported="true"></activity>
        <activity android:name=".EditCategoryActivity" android:exported="true"></activity>
        <activity android:name=".EditProfileActivity" android:exported="true"></activity>
        <activity android:name=".CustomerActivity" android:exported="true" ></activity>
        <activity android:name=".Activitycustomer" />

    </application>

</manifest>